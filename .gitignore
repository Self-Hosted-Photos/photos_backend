# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo

# ─── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Distribution / packaging ────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST

# ─── Testing & coverage ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.lcov
.tox/
.nox/

# ─── Type checking ───────────────────────────────────────────────────────────
.mypy_cache/
.pytype/
.pyre/

# ─── Environment variables ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Alembic ─────────────────────────────────────────────────────────────────
# alembic.ini is tracked — contains non-secret config
# migration files are tracked — they are source code

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Storage (local dev media files — never commit real uploads) ─────────────
storage/

# ─── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
